---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductArt from '../../components/shop/ProductArt.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import { categories, formatPrice, getProducts } from '../../lib/shop';
import { whatsappLink } from '../../data/site';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({
    params: { id: product.id },
    props: { product, related: products.filter((o) => o.data.category === product.data.category && o.id !== product.id).slice(0, 4) },
  }));
}) satisfies GetStaticPaths;

const { product, related } = Astro.props;
const p = product.data;
const { Content } = await render(product);
const category = categories.find((c) => c.id === p.category)!;
const name = `${p.brand} ${p.title}`;
const baseMessage = `Hola, me interesa ${name} (${formatPrice(p.price)}).`;
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  brand: { '@type': 'Brand', name: p.brand },
  category: category.label,
  offers: { '@type': 'Offer', price: p.price, priceCurrency: 'EUR', availability: 'https://schema.org/InStoreOnly' },
};
---
<Base title={name} description={`${name}: ${formatPrice(p.price)}. Consúltalo por WhatsApp y recógelo en Volea Padel Club.`} jsonLd={productLd}>
  <article class="product container">
    <nav class="crumbs" aria-label="Migas de pan">
      <a href="/tienda">Tienda</a>
      <span aria-hidden="true">/</span>
      <a href={`/tienda?c=${p.category}`}>{category.label}</a>
    </nav>

    <div class="product__grid">
      <div class="product__media" style={`--tint:${p.colors.main}`}>
        <ProductArt class="product__art" art={p.art} colors={p.colors} brand={p.brand} vtName={`art-${product.id}`} />
        {p.badge && <span class="product__badge">{p.badge}</span>}
      </div>

      <div class="product__info">
        <p class="eyebrow">{p.brand}</p>
        <h1 class="product__title">{p.title}</h1>
        <p class="product__price">
          {p.oldPrice && <s><span class="visually-hidden">Antes </span>{formatPrice(p.oldPrice)}</s>}
          <span>{formatPrice(p.price)}</span>
        </p>

        <div class="product__desc"><Content /></div>

        {p.sizes && (
          <fieldset class="sizes">
            <legend>Talla</legend>
            <div class="sizes__list">
              {p.sizes.map((size, i) => (
                <label class="size">
                  <input type="radio" name="size" value={size} checked={i === Math.floor(p.sizes!.length / 2)} data-size />
                  <span>{size}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <div class="product__actions">
          <a class="btn btn--ball product__cta" href={whatsappLink(baseMessage)} target="_blank" rel="noopener" aria-describedby="new-tab" data-wa data-message={baseMessage} data-magnetic>
            Consultar por WhatsApp
          </a>
          {p.category === 'palas' && (
            <a class="btn btn--ghost" href={whatsappLink(`Hola, me gustaría probar la pala ${name} en pista.`)} target="_blank" rel="noopener" aria-describedby="new-tab">
              Probarla en pista
            </a>
          )}
        </div>
        <p class="product__note">Web de demostración: no se realizan ventas online. Reserva por WhatsApp y recoge en recepción.</p>

        {p.specs.length > 0 && (
          <dl class="specs">
            {p.specs.map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related container" aria-labelledby="related-title">
      <h2 id="related-title" class="related__title" data-reveal>También en {category.label.toLowerCase()}</h2>
      <ul class="related__grid">
        {related.map((r) => <ProductCard product={r} />)}
      </ul>
    </section>
  )}
</Base>

<style>
  .product {
    padding-block: 8rem var(--section);
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .crumbs a {
    transition: color var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .crumbs a:hover {
      color: var(--line);
    }
  }

  .product__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .product__media {
    position: sticky;
    top: 6rem;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(70% 60% at 50% 45%, color-mix(in oklab, var(--tint) 40%, transparent), transparent),
      color-mix(in oklab, var(--court) 55%, var(--ink));
    border: 1px solid var(--hairline);
  }

  .product__art {
    width: 72%;
  }

  .product__badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    padding: 0.4em 0.9em;
    border-radius: 999px;
    background: var(--ball);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .product__info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product__title {
    font-size: var(--step-4);
  }

  .product__price {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
  }

  .product__price s {
    font-size: var(--step-1);
    color: var(--muted);
  }

  .product__desc {
    max-width: 52ch;
    color: var(--muted);
  }

  .sizes {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sizes legend {
    margin-bottom: 0.75rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sizes__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .size input {
    position: absolute;
    opacity: 0;
  }

  .size span {
    display: grid;
    place-items: center;
    min-width: 3rem;
    height: 3rem;
    padding-inline: 0.8rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out);
  }

  .size input:checked + span {
    background: var(--line);
    color: var(--ink);
  }

  .size input:focus-visible + span {
    outline: 2px solid var(--ball);
    outline-offset: 3px;
  }

  .product__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .product__cta {
    font-size: var(--step-0);
    padding: 1em 1.8em;
  }

  .product__note {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .specs {
    margin-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .specs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--hairline);
  }

  .specs dt {
    color: var(--muted);
  }

  .specs dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .related {
    padding-bottom: var(--section);
  }

  .related__title {
    margin-bottom: 2.5rem;
    font-size: var(--step-3);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 2.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 860px) {
    .product__grid {
      grid-template-columns: 1fr;
    }
    .product__media {
      position: relative;
      top: 0;
    }
  }
</style>

<script>
  import { whatsappLink } from '../../data/site';

  // La talla elegida viaja en el mensaje de WhatsApp.
  document.addEventListener('astro:page-load', () => {
    const cta = document.querySelector<HTMLAnchorElement>('[data-wa]');
    if (!cta) return;
    const update = () => {
      const size = document.querySelector<HTMLInputElement>('[data-size]:checked')?.value;
      cta.href = whatsappLink(size ? `${cta.dataset.message} Talla ${size}.` : cta.dataset.message!);
    };
    document.querySelectorAll('[data-size]').forEach((el) => el.addEventListener('change', update));
    update();
  });
</script>
