---
// Intro de primera visita: la bola cae, bota y se convierte en la "O" de VOLEA.
---
<script is:inline>
  // Antes de pintar: solo primera visita de la sesión y sin reduced motion.
  try {
    if (!sessionStorage.getItem('volea-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.setAttribute('data-preload', '');
      // Salida de emergencia si el JS no llega a cargar.
      setTimeout(() => document.documentElement.removeAttribute('data-preload'), 4000);
    }
  } catch {}
</script>

<div class="preloader" aria-hidden="true" data-preloader>
  <div class="preloader__logo">
    <span data-pl-v>V</span>
    <span class="preloader__ball" data-pl-ball></span>
    <span data-pl-lea>LEA</span>
  </div>
</div>

<style>
  .preloader {
    display: none;
  }

  :global(html[data-preload]) .preloader {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    background: var(--court);
  }

  :global(html[data-preload]) {
    overflow: hidden;
  }

  .preloader__logo {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(4rem, 16vw, 11rem);
    line-height: 1;
  }

  .preloader__ball {
    width: 0.74em;
    height: 0.74em;
    margin-inline: 0.03em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f3ff9a, var(--ball) 55%, #a9c21c);
  }
</style>

<script>
  import { gsap, EASE_OUT, EASE_IN_OUT, lenis } from '../../lib/motion';

  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-preloader]');

  if (el && root.hasAttribute('data-preload')) {
    lenis?.stop();
    const done = () => {
      root.removeAttribute('data-preload');
      sessionStorage.setItem('volea-intro', '1');
      lenis?.start();
    };

    gsap
      .timeline({ onComplete: done })
      .set('[data-pl-v], [data-pl-lea]', { opacity: 0 })
      .set('[data-pl-v]', { xPercent: 60 })
      .set('[data-pl-lea]', { xPercent: -30 })
      .from('[data-pl-ball]', { y: () => -innerHeight * 0.6, duration: 0.9, ease: 'bounce.out' })
      .from('[data-pl-ball]', { scaleY: 0.8, scaleX: 1.15, duration: 0.25, ease: EASE_OUT }, 0.32)
      .to('[data-pl-v], [data-pl-lea]', { opacity: 1, xPercent: 0, duration: 0.6, ease: EASE_OUT }, 0.75)
      .to(el, { yPercent: -100, duration: 0.9, ease: EASE_IN_OUT }, '+=0.15')
      .call(() => document.dispatchEvent(new Event('intro:done')), [], '<0.35');
  }
</script>
