---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Classes from '../components/home/Classes.astro';
import WhatsAppForm from '../components/WhatsAppForm.astro';
import { classSteps, classFaqs, levels } from '../data/club';
import { photos } from '../lib/photos';
---
<Base title="Clases" description="Clases de pádel en grupos de máximo 4 personas: iniciación, intermedio, avanzado, competición y escuela infantil. Prueba de nivel gratis.">
  <PageHero
    eyebrow="Escuela Volea"
    title="Aprende<br />jugando"
    lead="Grupos de máximo 4 por pista, entrenadores titulados y una prueba de nivel gratis para empezar en el grupo que te toca."
    image={photos['player-young']}
  >
    <a class="btn btn--ball" href="#apuntate" data-magnetic>Pide tu prueba gratis</a>
  </PageHero>

  <section class="section container" aria-labelledby="steps-title">
    <p class="eyebrow">Cómo funciona</p>
    <h2 id="steps-title" class="section-title" data-reveal>Tres pasos<br />y a la pista</h2>
    <ol class="steps">
      {classSteps.map((s, i) => (
        <li class="step">
          <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <Classes />

  <section class="section container faq" aria-labelledby="faq-title">
    <div>
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id="faq-title" class="section-title" data-reveal>Antes de<br />empezar</h2>
    </div>
    <div class="faq__list">
      {classFaqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="apuntate" class="section signup" aria-labelledby="signup-title">
    <div class="container signup__grid">
      <div>
        <p class="eyebrow">Apúntate</p>
        <h2 id="signup-title" class="section-title" data-reveal>Tu prueba<br />de nivel</h2>
        <p class="signup__lead">Rellena el formulario y te abrimos WhatsApp con el mensaje listo. Te contestamos en menos de un día.</p>
      </div>
      <WhatsAppForm
        intro="Hola, quiero hacer la prueba de nivel gratis."
        submit="Enviar por WhatsApp"
        fields={[
          { name: 'nombre', label: 'Nombre', required: true, autocomplete: 'name' },
          { name: 'telefono', label: 'Teléfono', type: 'tel', required: true, autocomplete: 'tel' },
          { name: 'grupo', label: 'Grupo que te interesa', type: 'select', options: levels.map((l) => l.name), required: true },
          { name: 'horario', label: 'Horario preferido', type: 'select', options: ['Mañanas', 'Mediodía', 'Tardes', 'Fines de semana'] },
          { name: 'mensaje', label: 'Algo que debamos saber', type: 'textarea' },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .step__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--ball);
  }

  .step__title {
    font-size: var(--step-2);
  }

  .step__text {
    color: var(--muted);
    max-width: 32ch;
  }

  .faq {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--gutter);
    align-items: start;
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq__item:first-child {
    border-top: 1px solid var(--hairline);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem;
    font-size: var(--step-1);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  /* Más que gira 45° y se convierte en una X. */
  .faq__item summary::after {
    content: '+';
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-weight: 400;
    transition: rotate 250ms var(--ease-out);
  }

  .faq__item[open] summary::after {
    rotate: 45deg;
  }

  .faq__item p {
    max-width: 56ch;
    padding-bottom: 1.4rem;
    color: var(--muted);
  }

  .signup {
    background: var(--court-deep);
    border-top: 1px solid var(--hairline);
  }

  .signup__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--gutter);
    align-items: start;
  }

  .signup__lead {
    max-width: 36ch;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .steps,
    .faq,
    .signup__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
