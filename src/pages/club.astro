---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/home/Testimonials.astro';
import { facilities, events } from '../data/club';
import { whatsappLink } from '../data/site';
import { photos } from '../lib/photos';

const day = new Intl.DateTimeFormat('es-ES', { day: '2-digit' });
const month = new Intl.DateTimeFormat('es-ES', { month: 'short' });
---
<Base title="El club" description="Volea Padel Club: instalaciones, torneos, ligas y comunidad. Un club hecho por jugadores.">
  <PageHero
    eyebrow="El club"
    title="Hecho por<br />jugadores"
    lead="Abrimos en 2014 con dos pistas y muchas ganas. Hoy somos más de 1.200 jugadores que comparten pista, liga y café."
    image={photos['handshake']}
  />

  <section class="section container story" aria-labelledby="story-title">
    <p class="eyebrow">Nuestra historia</p>
    <h2 id="story-title" class="visually-hidden">Nuestra historia</h2>
    <div class="story__grid">
      <p class="story__big">Queríamos un club donde el principiante y el jugador de torneo se sintieran igual de en casa.</p>
      <div class="story__text">
        <p>Por eso los grupos son pequeños, las pistas se cuidan como el primer día y en la cafetería siempre hay alguien buscando pareja para el partido de la tarde.</p>
        <p>Organizamos una liga interna por niveles, americanas cada viernes y un open por trimestre. Y si quieres probar una pala antes de comprarla, te la dejamos para que la uses en pista.</p>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="facilities-title">
    <p class="eyebrow">Instalaciones</p>
    <h2 id="facilities-title" class="section-title" data-reveal>Más que<br />pistas</h2>
    <ul class="facilities">
      {facilities.map((f, i) => (
        <li class="facility">
          <span class="facility__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="facility__title">{f.title}</h3>
          <p class="facility__text">{f.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section events" aria-labelledby="events-title">
    <div class="container">
      <p class="eyebrow">Torneos y ligas</p>
      <h2 id="events-title" class="section-title" data-reveal>Próximas<br />citas</h2>
      <ol class="events__list">
        {events.map((e) => {
          const d = new Date(`${e.date}T12:00:00`);
          return (
            <li class="event">
              <time class="event__date" datetime={e.date}>
                <span>{day.format(d)}</span>
                <span>{month.format(d).replace('.', '')}</span>
              </time>
              <div class="event__body">
                <h3 class="event__title">{e.title}</h3>
                <p class="event__meta">{e.level} · {e.price}</p>
              </div>
              <a class="btn btn--ghost" href={whatsappLink(`Hola, quiero apuntarme a ${e.title} (${e.date}).`)} target="_blank" rel="noopener" aria-describedby="new-tab">
                Apuntarme
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <Testimonials />
</Base>

<style>
  .story__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--gutter);
    margin-top: 2rem;
    align-items: end;
  }

  .story__big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1;
    text-transform: uppercase;
  }

  .story__text {
    display: grid;
    gap: 1rem;
    color: var(--muted);
  }

  .facilities {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .facility {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 2rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .facility:not(:nth-child(3n + 1)) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--hairline);
  }

  .facility__num {
    font-size: var(--step--1);
    color: var(--ball);
    letter-spacing: 0.14em;
  }

  .facility__title {
    font-size: var(--step-2);
  }

  .facility__text {
    color: var(--muted);
    max-width: 30ch;
  }

  .events {
    background: var(--court-deep);
  }

  .events__list {
    padding: 0;
    list-style: none;
  }

  .event {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .event:first-child {
    border-top: 1px solid var(--hairline);
  }

  .event__date {
    display: grid;
    justify-items: center;
    width: 5rem;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .event__date span:first-child {
    font-size: var(--step-3);
    color: var(--ball);
  }

  .event__title {
    font-size: var(--step-2);
  }

  .event__meta {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 860px) {
    .story__grid {
      grid-template-columns: 1fr;
    }
    .facilities {
      grid-template-columns: 1fr 1fr;
    }
    .facility:not(:nth-child(3n + 1)) {
      padding-left: 0;
      border-left: 0;
    }
    .facility:nth-child(even) {
      padding-left: 1.5rem;
      border-left: 1px solid var(--hairline);
    }
  }

  @media (max-width: 560px) {
    .facilities {
      grid-template-columns: 1fr;
    }
    .facility:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .event {
      grid-template-columns: auto 1fr;
    }
    .event .btn {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
