---
// Wordmark: la "O" de VOLEA es la bola.
---
<span class="logo" aria-label="Volea" role="img">
  <span aria-hidden="true">V</span>
  <svg class="logo__ball" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="15" fill="var(--ball)" />
    <path d="M5 8.5c6.5 4.5 6.5 10.5 0 15M27 8.5c-6.5 4.5-6.5 10.5 0 15" fill="none" stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <span aria-hidden="true">LEA</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .logo__ball {
    width: 0.74em;
    height: 0.74em;
    margin-inline: 0.03em;
    translate: 0 -0.02em;
  }
</style>
