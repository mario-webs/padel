---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
}
const { eyebrow, title, lead, image } = Astro.props;
---
<header class:list={['page-hero', { 'page-hero--image': image }]}>
  {image && (
    <div class="page-hero__media" aria-hidden="true">
      <Image quality={65} src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="container page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title" data-reveal set:html={title} />
    <p class="page-hero__lead">{lead}</p>
    <slot />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-items: end;
    padding-block: 10rem 4rem;
    overflow: hidden;
  }

  .page-hero--image {
    min-height: 88svh;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Velo para que el texto se lea sobre cualquier foto. */
  .page-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--ink) 5%, transparent 60%),
      linear-gradient(to right, color-mix(in oklab, var(--ink) 75%, transparent), transparent 70%);
  }

  .page-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .page-hero__title {
    font-size: var(--step-5);
  }

  .page-hero__lead {
    max-width: 46ch;
    color: var(--muted);
  }

  .page-hero--image .page-hero__lead {
    color: var(--line);
  }
</style>
